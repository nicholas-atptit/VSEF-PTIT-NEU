# ── VN100 Algo Trading Environment Variables ────────────────────────

# DNSE API (Execution Layer)
DNSE_API_KEY=""
DNSE_API_SECRET=""
DNSE_BASE_URL="https://openapi.dnse.com.vn"

# Vnstock API (Data Layer)
VNSTOCK_API_KEY=""

# Database (TimescaleDB)
TIMESCALE_HOST="localhost"
TIMESCALE_PORT=5432
TIMESCALE_DB="algo_trading"
TIMESCALE_USER="postgres"
TIMESCALE_PASSWORD="your_password_here"

# Redis (Caching)
REDIS_URL="redis://localhost:6379"

# LLM Providers (Qualitative Analysis)
LLM_PROVIDER="gemini" # choices: ollama, openai, groq, gemini

OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Logging & Monitoring
LOG_LEVEL="INFO" # choices: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT="json" # choices: json, console
