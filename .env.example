# ============================================================
# DNSE API Credentials
# ============================================================
DNSE_API_KEY=your-api-key-here
DNSE_API_SECRET=your-api-secret-here

# ============================================================
# TimescaleDB (PostgreSQL)
# ============================================================
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=algo_trading
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres
TIMESCALE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/algo_trading

# ============================================================
# ChromaDB
# ============================================================
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ============================================================
# Streaming Settings & Kafka Message Broker
# ============================================================
KAFKA_BROKER_URL=localhost:9092
PING_INTERVAL_SECONDS=1
RECONNECT_DELAY_SECONDS=5
MAX_RECONNECT_ATTEMPTS=10

# ============================================================
# Filter Engine
# ============================================================
BLACKLIST_REFRESH_INTERVAL_MINUTES=5
INDICATOR_BUFFER_SIZE=200

# ============================================================
# Historical Backdate
# ============================================================
BACKDATE_RATE_LIMIT_DELAY=0.5
BACKDATE_BATCH_SIZE=100

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================
# LLM Pipeline (Phase 3 & 4)
# ============================================================
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL_NAME=qwen3:8b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o

GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-pro
